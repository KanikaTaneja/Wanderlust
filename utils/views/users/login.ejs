<%- layout("layouts/boilerplate") -%>
<br>
<h3 class="col-6 offset-3" >Login here on Wanderlust !</h3>
 <div class="row mt-3">
    <div class="col-6 offset-3">
    <form method="post" action="/login" novalidate class="row needs-validation">
       <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input  
            name="username" 
            id="username"
            type="text" 
            class="form-control"
            required
            />
         
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input  
            name="password" 
            id="password"
            type="password" 
            class="form-control"
            required
            />
        </div>
        <div class="mb-3">
        <button class="btn btn-success">Login</button>
        </div>
    </form>

    </div>
</div>