<% layout("/layouts/boilerplate") -%>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    const listingTitle = "<%= listing.title %>";
     const listingLocation = "<%= listing.location %>"; // add this
</script>
<div class="row">
    <div class="col-10 mt-3">

        <h1> <%=listing.title %> :</h1>
     
        <div class="card col-6 listing-card">
            <img src=" <%= listing.image.url %>" class="card-img-top show-img"  alt="listing img">
            <div class="card-body">
                <p class="card-text"> 
                    <!-- <b><%=listing.title %></b> <br> -->
                    
                </p>
            </div>
        </div>
     </div>
    <div class="col-10 mt-3">
    <ul>
        <li>
            
            <b>Owned by </b> :  <%=listing.owner.username %>
        </li>
        <li>
            <%=listing.description %>
        </li>
        
        <li>
           &#8377;<%= listing.price?.toLocaleString("en-IN") || "Price not available" %> /night
        </li>
        
        <li>
            <%=listing.location %>
        </li>
        
        <li>
            <%=listing.country %>
        </li>
     </ul>
    </div>
    

    <% if (currentUser && currentUser._id.equals(listing.owner._id)) { %>
    <div class="d-flex gap-4 mb-4">
        <a href="/listings/<%=listing._id %>/edit" class="btn btn-dark edit-btn"> Edit </a>
        <form method="post" action="/listings/<%=listing._id %>?_method=DELETE">
            <button class="btn btn-dark"> Delete </button>
        </form>
    </div>
<% } %>
   
<!-- /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// -->

     <div col-10 mt-3 mb-3>
        
        
        <% if (currentUser) { %>
            <hr/>
            <h4>Leave a review : </h4>
               <form action="/listings/<%=listing._id %>/reviews" method="post" novalidate class="row needs-validation">
            <div class="mb-3 mt-3">
                <fieldset class="starability-growRotate">
                <!-- <label for="rating" class="form-label"> Rating</label> -->
                
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>
            
             <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea 
                name="review[content]" 
                id="comment" 
                cols="30" 
                rows="10" 
                class="form-control"
                required
                ></textarea>
                 <!-- <div class="valid-feedback">Looks good!</div> -->
                 <div class="invalid-feedback">Please add some comments for review</div>
             </div>
             
             <br>
             <button class="btn btn-outline-dark">Submit</button>
             
        </form>
        <% } %>
       

        <hr>

    <% if (listing.reviews.length>0) { %>
              <div class="row">
            <h4> All Reviews </h4>
              <% for( revieww of listing.reviews ) { %>
              <div class="card col-5 mb-3 me-3 mt-3">
                  <div class="card-body">
                    <br>
                    <h6 class="card-title" > @<%=revieww.author.username %></h6>
                    <p class="card-text"> <%= revieww.content %></p>
                    <!-- <p class="card-text"> <%= revieww.rating %>⭐</p> -->
                    <p class="starability-result" data-rating="<%= revieww.rating %>"> </p>
                  </div>
                <form method="post" action="/listings/<%=listing._id %>/reviews/<%= revieww._id %>?_method=DELETE">
                   <button class="btn btn-sm btn-outline-dark" style="width: 100px; margin-bottom: 10px; margin-top: 10px;">Delete</button>
                 </form>
              </div>
              <% } %>
       </div> 
    <% } %>
    
       
     </div>
  
     <div col-10 mt-3 mb-3>
        <h3>Where you'll be !</h3>
        <div id='map' style="height: 400px; width: 100%; max-width: 800px; margin-bottom: 2rem; background-color: #eee;"></div>
    </div>
</div>

 <link href="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.css" rel="stylesheet" />
    <script src="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.js"></script>

<script src="/js/maplibre.js"></script>
