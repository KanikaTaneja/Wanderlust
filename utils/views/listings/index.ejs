<% layout("/layouts/boilerplate") -%>

    <style>
      #filters{
        display: flex;  
        /* to bring all icons in came line */
        flex-wrap: wrap;
        margin-right: 4rem;
      }
      .filter{
        text-align: center;
        /* margin-left: 2rem; */
        margin-right: 2rem;
        margin-top: 2rem;
        opacity: 0.7;
       
      }
      .filter:hover{
        opacity: 1;
        cursor: pointer;
      }
      .filter p {
        font-size: 0.8rem;
      }
      .form-check{
        margin-left: 1rem;
        margin-top: 1rem;
      }
    .tax-info{
        display: none;
    }
    .tax-toggle{
        border: 0.5px solid black;
        border-radius: 15px;
        padding-left: 7px;
        padding-right: 7px;
        
      height: 3.6rem;
      margin-top: 20px;
      
       display: flex;
       text-align: center;
    }
    .form-check-label{
        font-size:14px;
        border-radius: 1rem ;
    }
    
         
      
    </style>


  <div id="filters" class="ms-5">
      <div class="filter">
        <div><i class="fa-solid fa-fire"></i> </div>
        <p>Trending</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-tree-city"></i></div>
        <p>Iconic cities</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>farms</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-panorama"></i></div>
        <p>Amazing views</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing pools</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-house-flag"></i></div>
        <p>Cabins</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-fire"></i> </div>
        <p>Trending</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-fire"></i> </div>
        <p>Trending</p>
      </div>
    <!-- // toggle    -->
    <div class="tax-toggle">
        <div class="form-check form-switch ms-auto box ">
            <input 
            class="form-check-input" 
            type="checkbox" 
            role="switch" 
            id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
    
  </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 ms-5 mt-3">
<% for( let list of listings ) { %>
   
    <div class="card col listing-card" style="width: 18rem;">
         <a href="/listings/<%= list._id %>" style="text-decoration: none;">

            <img src="<%= list.image.url %>" class="card-img-top" alt="listing img">
         </a>
  <div class="card-body">
    
    <p class="card-text">
        <b><%= list.title %></b> <br>
        &#8377;<%= list.price?.toLocaleString("en-IN") || "Price not available" %> /night
        <i class="tax-info">&nbsp;+ 18% GST</i>
        </p>

  </div>
</div>

<% } %>
</div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click" , ()=>{
        let taxInfo = document.getElementsByClassName("tax-info");
        for (let info of taxInfo) {
            if(info.style.display != "inline"){
                  info.style.display="inline";
            } else {
                info.style.display="none";
            }
            
        }
    })
</script>