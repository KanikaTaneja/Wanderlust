<% layout("/layouts/boilerplate") -%>

<style>
  .card-container {
    margin: 0 auto;
    max-width: 1400px;
  }
 #filters-wrapper {
  margin: 0 auto;
  max-width: 1400px;
}

#filters {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE/Edge */
  gap: 0.5rem;
  padding-bottom: 0.5rem;
}
#filters::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.filter {
  text-align: center;
  flex: 0 0 auto; /* prevent shrinking/wrapping, keep natural size */
  margin-right: 2rem;
  margin-top: 2rem;
  opacity: 0.7;
}

@media (max-width: 767px) {
  #filters-wrapper {
    margin-left: 1rem !important; /* override ms-5 on mobile */
    margin-right: 1rem;
  }
  .filter {
    margin-right: 1.2rem;
    margin-top: 1rem;
  }
  .filter i {
    font-size: 0.9rem;
  }
  .filter p {
    font-size: 0.7rem;
  }
  .tax-toggle {
    margin-top: 1rem;
    height: auto;
    padding: 8px 12px;
  }
}
</style>


