      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
  </div> <!-- closes #filters -->

  <div class="tax-toggle">
    <div class="form-check form-switch ms-auto box">
      <input 
        class="form-check-input" 
        type="checkbox" 
        role="switch" 
        id="switchCheckDefault">
      <label 
        class="form-check-label" 
