<style>
  .btn-search{
    background-color: #fe424d;
    color: white;
    border-radius: 2rem;
    padding: 0 1rem 0 1rem;
  }
 .btn-search:hover{
    background-color: #fe424d;
    color: white;
    border-radius: 2rem;
  }
  .btn-search i {
    display: inline;
    margin-right: 7px;
  }
  .search-bar{
    margin-left: auto;
    border: 1px solid black;
    padding: 11px;
    border-radius: 2rem;
    max-width: 100%;
    box-sizing: border-box;
  }
  .search-bar form {
    display: flex;
    min-width: 0;
  }
  .form-input {
  border-radius: 2rem;
  width: clamp(30px, 15vw, 100px);
  flex: none;
}
  @media (max-width: 767.98px) {
    .navbar-collapse{
      margin-left: 0%;
    }
  .search-bar {
    max-width: 100%;
    width: fit-content;
    margin-left: 0px;
  }
  .search-bar form {
    flex-wrap: nowrap;
  }
  .form-input {
    font-size: 0.75rem;
    padding: 4px 6px;
  }
  .btn-search {
    padding: 0 0.6rem;
  }
  .btn-search .btn-text {
    display: none;
  }
}
.container-fluid{
  background-color: white;
}
@media (min-width: 768px) and (max-width: 991.98px) {
  .navbar-nav a.nav-link {
    font-size: 0.85rem;
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
  }
}
@media (min-width: 568px) and (max-width: 767.98px) {
  .card-container > .col {
    flex: 0 0 33.333%;
    max-width: 33.333%;
  }
}
  
</style>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid mb-1">
    <a class="navbar-brand" href="/listings" style="font-size: x-large;"><i class="fa-regular fa-compass"></i>Wanderlust</a>
    <button 
    class="navbar-toggler" 
    type="button" 
    data-bs-toggle="collapse" 
    data-bs-target="#navbarNavAltMarkup" 
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>
      <div class="navbar-nav search-bar">
        <form class="d-flex" role="search">
          <input class="form-control form-input  me-2" type="search" placeholder="Where" aria-label="Search"/>
          <input class="form-control form-input me-2" type="search" placeholder="When" aria-label="Search"/>
          <input class="form-control form-input me-2" type="search" placeholder="Who" aria-label="Search"/>
          <button 
            class="btn btn-search" 
            type="submit"> 
            <i class="fa-solid fa-magnifying-glass"></i>
            <span class="btn-text">Search</span>
          </button>
        </form>
      </div>
      
        <div class="navbar-nav ms-auto">
          <a class="nav-link" href="/listings/new">Airbnb your home</a>
          <% if (typeof currentUser === "undefined" || !currentUser) { %>
              <a class="nav-link"  href="/signup"><b>Sign up</b></a>
              <a class="nav-link" href="/login"><b>Login</b></a>
          <% } %>
          <% if (typeof currentUser !== "undefined" && currentUser) { %>
              <a class="nav-link" href="/logout"><b>Log out</b></a>
          <% } %>
        
       </div>
    </div>
  </div>
</nav>