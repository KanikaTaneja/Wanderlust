<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if (listingaddedmssg && listingaddedmssg.length ) { %>
         <div class="alert alert-success alert-dismissible fade show col-6 offset-3 mt-1" role="alert" >
        <%= listingaddedmssg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
   
   <% if (error && error.length) { %>
        <div class="alert alert-danger alert-dismissible fade show col-6 offset-3 mt-1" role="alert" >
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
   <% } %>

</body>
</html>